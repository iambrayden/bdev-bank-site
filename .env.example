# First start only: creates this superadmin account if no users exist yet.
# After that, manage users in Admin → Users (changing these later does nothing).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long
# Optional: hours a login stays valid
SESSION_HOURS=12

# Game database (use a SELECT-only user)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bank_audit
DB_PASSWORD=
DB_NAME=s1_lcrpdatabase

# Core table: the master list of characters
PLAYERS_TABLE=players
# Optional: linked tables as name:role pairs (otherwise the Qbox defaults are used)
# Roles: player_transactions, bank_accounts, house_bills, house_locations, player_houses,
#        player_vehicles, player_groups, job_activity, generic
AUDIT_TABLES=player_transactions:player_transactions,bank_accounts_new:bank_accounts,house_bills:house_bills,houselocations:house_locations,player_houses:player_houses,player_jobs_activity:job_activity,player_vehicles:player_vehicles,player_groups:player_groups

# Branding (optional)
APP_NAME=SAFIN
APP_TAGLINE=San Andreas Financial Intelligence Network
BANNER_TEXT=Restricted · Authorized use only · All activity is monitored and logged

# Timezone used to display times
TZ_DISPLAY=America/Chicago
