<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= appName %></title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<% if (bannerText) { %><div class="govbanner" role="note"><%= bannerText %></div><% } %>
<% if ((typeof nav === 'undefined' || nav) && user) { %>
<header class="top">
  <a class="brand" href="/" title="<%= appTagline %>"><%- include('seal', { size: 34 }) %><span><b><%= appName %></b><% if (appTagline) { %><small><%= appTagline %></small><% } %></span></a>
  <nav>
    <% const links = [
      ['/', 'Overview', can('dashboard.view')],
      ['/citizens', 'Citizens', can('players.view')],
      ['/accounts', 'Shared accounts', can('accounts.view')],
      ['/transactions', 'Transactions', can('transactions.view')],
      ['/audit', 'Audit flags', can('audit.view')],
      ['/cases', 'Cases', can('cases.view') || can('cases.view_all')],
      ['/tables', 'Tables', can('tables.browse')],
      ['/admin', 'Admin', can('admin.users') || can('admin.roles') || can('admin.activity') || can('admin.settings')],
    ]; %>
    <% for (const [href, label, ok] of links) { if (!ok) continue; const on = href === '/' ? path === '/' : path.startsWith(href) || (href === '/admin' && path.startsWith('/settings')); %>
      <a href="<%= href %>" class="<%= on ? 'on' : '' %>"><%= label %></a>
    <% } %>
  </nav>
  <% if (can('players.view')) { %>
  <form class="search" action="/citizens" method="get">
    <input name="q" placeholder="Name / citizenid" aria-label="Search citizens">
  </form>
  <% } %>
  <div class="me">
    <a href="/account" title="My account"><%= user.display_name || user.username %></a>
    <form action="/logout" method="post"><button class="link">Log out</button></form>
  </div>
</header>
<% } %>
<main>
<% if (typeof query !== 'undefined' && query.msg && !(typeof msg !== 'undefined' && msg)) { %><p class="notice"><%= query.msg %></p><% } %>
