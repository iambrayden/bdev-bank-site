<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Bank Audit</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<% if (typeof nav === 'undefined' || nav) { %>
<header class="top">
  <a class="brand" href="/">Bank Audit</a>
  <nav>
    <% const links = [['/', 'Overview'], ['/players', 'Characters'], ['/accounts', 'Shared accounts'], ['/transactions', 'Transactions'], ['/audit', 'Audit flags'], ['/tables', 'Tables'], ['/settings', 'Settings']]; %>
    <% for (const [href, label] of links) { const on = href === '/' ? path === '/' : path.startsWith(href); %>
      <a href="<%= href %>" class="<%= on ? 'on' : '' %>"><%= label %></a>
    <% } %>
  </nav>
  <form class="search" action="/players" method="get">
    <input name="q" placeholder="Name / citizenid / license" aria-label="Search characters">
  </form>
  <% if (authEnabled) { %>
  <form action="/logout" method="post"><button class="link">Log out</button></form>
  <% } %>
</header>
<% } %>
<main>
