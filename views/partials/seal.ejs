<%# Fictional seal (inline SVG; deliberately not a real state seal). size: px %>
<% const sealSize = typeof size !== 'undefined' ? size : 40; const sealId = 's' + Math.random().toString(36).slice(2, 8); const sealName = String(appName || '').toUpperCase().slice(0, 10); const sealState = String(stateName || '').toUpperCase().slice(0, 24); %>
<svg class="seal" width="<%= sealSize %>" height="<%= sealSize %>" viewBox="0 0 120 120" role="img" aria-label="<%= stateName %> seal">
  <defs>
    <path id="<%= sealId %>t" d="M 16,60 A 44,44 0 0,1 104,60"/>
    <path id="<%= sealId %>b" d="M 9,60 A 51,51 0 0,0 111,60"/>
  </defs>
  <circle cx="60" cy="60" r="58" fill="#0f2747" stroke="#c9a227" stroke-width="3"/>
  <circle cx="60" cy="60" r="38" fill="none" stroke="#c9a227" stroke-width="1.5"/>
  <text font-family="Georgia, serif" font-size="<%= sealState.length > 18 ? 8.5 : 10.5 %>" font-weight="700" fill="#c9a227" letter-spacing="1.2" text-anchor="middle">
    <textPath href="#<%= sealId %>t" startOffset="50%"><%= sealState %></textPath>
  </text>
  <text font-family="Georgia, serif" font-size="8" font-weight="700" fill="#c9a227" letter-spacing="1" text-anchor="middle">
    <textPath href="#<%= sealId %>b" startOffset="50%">· DEPARTMENT OF JUSTICE ·</textPath>
  </text>
  <polygon fill="#c9a227" points="60.0,39.0 64.1,50.3 76.2,50.7 66.7,58.2 70.0,69.8 60.0,63.0 50.0,69.8 53.3,58.2 43.8,50.7 55.9,50.3"/>
  <text x="60" y="88" text-anchor="middle" font-family="Georgia, serif" font-size="<%= sealName.length > 6 ? 6.5 : 8 %>" font-weight="700" fill="#e8d9a8" letter-spacing="1"><%= sealName %></text>
</svg>
