<div class="scroll">
<table class="data">
<thead><tr><th>Severity</th><th>Flag</th><th>Details</th><th>Subject</th><th class="r">Amount</th><th>When</th><% if (can('cases.edit') || can('cases.create')) { %><th></th><% } %></tr></thead>
<tbody>
<% if (!list.length) { %><tr><td colspan="7" class="muted">Nothing flagged.</td></tr><% } %>
<% for (const f of list) { %>
<tr>
  <td><span class="sev <%= f.severity %>"><%= f.severity %></span></td>
  <td><strong><%= red(f.title) %></strong><br><span class="muted small mono"><%= f.code %></span></td>
  <td class="msg"><%= red(f.detail) %><% if (f.trans_id && can('transactions.view')) { %><br><a class="small" href="/transactions?q=<%= encodeURIComponent(f.trans_id) %>">find transaction</a><% } %></td>
  <td class="nowrap">
    <% if (f.citizenid) { const o = s.playerMap.get(f.citizenid); %><a href="/citizens/<%= encodeURIComponent(f.citizenid) %>"><%= o ? o.name : f.citizenid %></a><% } else if (f.accountType === 'shared') { %><a class="tag" href="/accounts/<%= encodeURIComponent(f.account) %>"><%= f.account %></a><% } else if (f.account) { %><a href="/citizens/<%= encodeURIComponent(f.account) %>"><%= f.account %></a><% } %>
  </td>
  <td class="r mono"><%= f.amount !== undefined ? money(f.amount) : '' %></td>
  <td class="nowrap small"><%= f.time ? fmt.date(f.time) : '' %></td>
  <% if (can('cases.edit') || can('cases.create')) { %><td><a class="addcase" title="Add to case" href="/cases/attach?type=flag&ref=<%= f.id %>">+ case</a></td><% } %>
</tr>
<% } %>
</tbody>
</table>
</div>
