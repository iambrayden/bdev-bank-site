<%- include('partials/head', { title: 'Tables' }) %>
<h1>Configured tables</h1>
<p class="muted">Every table here is linked to the core players table by citizenid. Add or change tables in <a href="/settings#tables">Settings</a>.</p>
<table class="data">
<thead><tr><th>Table</th><th>Role</th><th class="r">Rows</th><th></th></tr></thead>
<tbody>
<% configured.forEach((t, i) => { const r = ROLES[t.role] || ROLES.generic; %>
<tr class="<%= i === 0 ? 'core' : '' %>">
  <td class="mono"><%= t.name %><% if (i === 0) { %> <span class="pill in">core</span><% } %></td>
  <td><%= r.label %><br><span class="small muted"><%= r.description %></span></td>
  <td class="r"><%= exists.has(t.name) ? fmt.int(counts[t.name]) : '' %></td>
  <td><% if (exists.has(t.name)) { %><a href="/tables/<%= encodeURIComponent(t.name) %>">Browse →</a><% } else { %><span class="err">missing in database</span><% } %></td>
</tr>
<% }) %>
</tbody>
</table>
<%- include('partials/foot') %>
