<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= caseNo(c.id) %> · <%= c.title %></title>
<link rel="stylesheet" href="/static/style.css?v=<%= assetVersion %>">
</head>
<body class="print">
<main>
<p class="noprint"><button onclick="window.print()">Print / save as PDF</button> <a href="/cases/<%= c.id %>">← back to case</a></p>
<div class="printhead"><%- include('partials/seal', { size: 56 }) %><div><div class="small caps"><%= stateName %></div><b><%= appName %></b><% if (appTagline) { %> · <%= appTagline %><% } %><div class="small caps neg">Restricted · Law enforcement sensitive</div></div></div>
<h1><%= caseNo(c.id) %> — <%= c.title %></h1>
<dl class="kv">
  <dt>Status</dt><dd><%= c.status.replace('_', ' ') %> · priority <%= c.priority %></dd>
  <dt>Opened</dt><dd><%= fmt.date(c.created_at) %> by <%= c.created_by_name || '—' %></dd>
  <dt>Assigned</dt><dd><%= c.assigned_to_name || '—' %><% if (members.length) { %> · collaborators: <%= members.map(m => m.username).join(', ') %><% } %></dd>
  <% if (c.closed_at) { %><dt>Closed</dt><dd><%= fmt.date(c.closed_at) %></dd><% } %>
  <dt>Report generated</dt><dd><%= fmt.date(printedAt) %> by <%= user.username %></dd>
</dl>
<h2>Summary</h2><div class="prewrap"><%= c.summary || '—' %></div>
<% if (c.outcome) { %><h2>Outcome</h2><div class="prewrap"><%= c.outcome %></div><% } %>

<h2>Citizens involved (<%= subjects.length %>)</h2>
<table class="data">
<thead><tr><th>Citizen</th><th>Citizen ID</th><th>Involvement</th><th>Job</th><th class="r">Bank when added</th><th>Note</th></tr></thead>
<tbody><% for (const sub of subjects) { const t = sub.snapshot || {}; %>
<tr><td><%= sub.name || t.name || '' %></td><td class="mono"><%= sub.citizenid %></td><td><%= sub.label %></td><td><%= t.job || '' %></td><td class="r mono"><%= t.bank !== undefined ? money(t.bank || 0) : '' %></td><td><%= sub.note %></td></tr>
<% } %></tbody>
</table>

<h2>Evidence (<%= evidence.length %>)</h2>
<% evidence.forEach((e, i) => { %>
<article class="evidence">
  <header><b>#<%= i + 1 %> <%= EVIDENCE_TYPES[e.type] || e.type %>:</b> <%= red(e.title) %> <span class="small muted">— added <%= fmt.date(e.added_at) %> by <%= e.added_by_name || '—' %></span></header>
  <%- include('partials/evidence', { e }) %>
  <% if (e.note) { %><p class="small"><b>Investigator note:</b> <%= e.note %></p><% } %>
</article>
<% }) %>

<h2>Notes</h2>
<ol class="timeline">
<% for (const n of notes) { %><li class="<%= n.kind %>"><div class="small muted"><%= fmt.date(n.created_at) %> · <%= n.kind === 'system' ? 'system' : (n.username || '—') %></div><div class="prewrap"><%= n.body %></div></li><% } %>
</ol>
<p class="govfoot">Restricted. Prepared under warrant for official use only. Do not disseminate outside the authorized case.</p>
<p class="small muted">Amounts and balances were captured when each item was added. Times in <%= fmt.TZ %>.</p>
</main>
</body>
</html>
