<%- include('../partials/head', { title: u ? u.username : 'New user' }) %>
<h1>Admin</h1>
<%- include('../partials/admintabs') %>
<% if (msg) { %><p class="notice"><%= msg %></p><% } %>
<div class="crumbs"><a href="/admin/users">Users</a> / <%= u ? u.username : 'new' %></div>
<h2><%= u ? `Edit ${u.username}` : 'New user' %></h2>

<form method="post" action="<%= u ? `/admin/users/${u.id}` : '/admin/users' %>">
<section class="card">
  <div class="formgrid">
    <label>Username <input name="username" value="<%= u ? u.username : '' %>" <%= u ? 'disabled' : 'required' %> pattern="[A-Za-z0-9_.\-]{2,40}" autocomplete="off"></label>
    <label>Display name <input name="display_name" value="<%= u ? u.display_name : '' %>" maxlength="80"></label>
    <label>Role
      <select name="role_id">
        <option value="">— no role —</option>
        <% for (const r of roles) { %><option value="<%= r.id %>" <%= u && u.role_id === r.id ? 'selected' : '' %>><%= r.name %> (<%= r.permissions.length %> permissions)</option><% } %>
      </select>
    </label>
    <% if (!u) { %>
    <label>Password <input name="password" type="password" required minlength="10" autocomplete="new-password"></label>
    <% } %>
  </div>
  <div class="checks mt">
    <% if (!u) { %><label class="small"><input type="checkbox" name="must_change_password" value="1" checked> Must change password at first login</label><% } %>
    <% if (user.is_superadmin) { %><label class="small"><input type="checkbox" name="is_superadmin" value="1" <%= u && u.is_superadmin ? 'checked' : '' %>> Superadmin (every permission, can manage other superadmins)</label><% } %>
    <% if (u) { %><label class="small"><input type="checkbox" name="disabled" value="1" <%= u.disabled ? 'checked' : '' %>> Disabled (cannot log in)</label><% } %>
  </div>
  <label class="mt">Admin notes <textarea name="notes" rows="2" placeholder="e.g. Staff team, Discord name"><%= u ? u.notes : '' %></textarea></label>
</section>

<section class="card">
  <h2>Permission overrides</h2>
  <p class="small muted">Each permission comes from the user's role unless you override it here. <b>Allow</b> grants it even if the role doesn't; <b>Deny</b> removes it even if the role has it. Superadmins always have everything.</p>
  <% const roleSet = new Set(u ? u.role_permissions : []); %>
  <%- include('../partials/permgrid', { mode: 'tri', u, roleSet, grantable }) %>
</section>
<div class="actions"><button><%= u ? 'Save user' : 'Create user' %></button></div>
</form>

<% if (u) { %>
<div class="grid2 mt">
  <section class="card">
    <h2>Effective permissions <span class="muted">(<%= effective.size %>)</span></h2>
    <p class="small"><% for (const p of effective) { %><span class="tag mono small"><%= p %></span> <% } %></p>
  </section>
  <section class="card">
    <h2>Security</h2>
    <form method="post" action="/admin/users/<%= u.id %>/password" class="stack">
      <label>New password <input name="password" type="password" minlength="10" required autocomplete="new-password"></label>
      <label class="small"><input type="checkbox" name="must_change_password" value="1" checked> Must change at next login</label>
      <div class="actions"><button class="ghost">Reset password</button></div>
    </form>
    <form method="post" action="/admin/users/<%= u.id %>/sessions" class="mt"><button class="ghost">Sign out everywhere (<%= sessions %> active)</button></form>
    <% if (u.id !== user.id) { %>
    <form method="post" action="/admin/users/<%= u.id %>/delete" class="mt" onsubmit="return confirm('Delete <%= u.username %>? Their notes and evidence stay on cases.')"><button class="ghost danger">Delete user</button></form>
    <% } %>
  </section>
</div>
<section class="card">
  <h2>Recent activity</h2>
  <%- include('../partials/activity', { rows: activity }) %>
  <p><a class="small" href="/admin/activity?user=<%= encodeURIComponent(u.username) %>">Full activity →</a></p>
</section>
<% } %>
<%- include('../partials/foot') %>
